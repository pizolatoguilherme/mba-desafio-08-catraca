<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Catraca</title>
  <style>
    :root { color-scheme: light dark; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
    body { margin: 0; line-height: 1.5; }
    header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; border-bottom: 1px solid #8884; }
    header [data-brand] { font-weight: 700; font-size: 1.25rem; text-decoration: none; color: inherit; }
    main { max-width: 960px; margin: 0 auto; padding: 1rem; }
    table { border-collapse: collapse; width: 100%; }
    th, td { text-align: left; padding: .4rem .5rem; border-bottom: 1px solid #8884; }
    input, button, select { font: inherit; padding: .35rem .5rem; }
  </style>
</head>
<body>
  <header>
    <a href="/" data-brand>Catraca</a>
    <nav data-nav><%# F02: locals.user é null (visitante) ou o usuário; undefined só sem o plugin de auth. %><% if (locals.user !== undefined) { -%>
<% if (locals.user) { -%>
      <span data-current-user><%= locals.user.name %></span>
<% if (locals.user.role === 'organizer') { -%>
      <a href="/org/events">Meus eventos</a>
<% } else { -%>
      <a href="/me/tickets">Meus ingressos</a>
<% } -%>
      <form method="post" action="/logout" data-logout><button type="submit">Sair</button></form>
<% } else { -%>
      <a href="/login" data-nav-login>Entrar</a>
      <a href="/signup" data-nav-signup>Criar conta</a>
<% } -%>
    <% } %></nav>
  </header>
  <main><%- body %></main>
</body>
</html>
